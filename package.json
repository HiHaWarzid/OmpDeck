{
  "name": "omp-deck",
  "version": "0.6.7",
  "description": "OmpDeck is an open-source desktop workbench to manage multiple omp AI coding agents across local project folders with session history, Git integration, terminal, and config management. Forked from ayuayue/PiDeck.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "ayuayue",
    "email": "ayuayue@users.noreply.github.com"
  },
  "contributors": [
    {
      "name": "1900EasonJin",
      "url": "https://github.com/1900EasonJin"
    },
    {
      "name": "HiHaWarzid",
      "url": "https://github.com/HiHaWarzid"
    }
  ],
  "homepage": "https://github.com/HiHaWarzid/OmpDeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiHaWarzid/OmpDeck.git"
  },
  "bugs": {
    "url": "https://github.com/HiHaWarzid/OmpDeck/issues"
  },
  "keywords": [
    "omp",
    "omp-agent",
    "oh-my-pi",
    "ai-coding-agent",
    "coding-agent",
    "electron",
    "electron-app",
    "desktop",
    "desktop-app",
    "rpc",
    "agent",
    "ai-assistant",
    "local-ai",
    "developer-tools",
    "productivity",
    "workspace",
    "session-management",
    "git",
    "terminal",
    "monaco-editor",
    "claude-code",
    "codex",
    "multi-project",
    "typescript",
    "windows",
    "macos",
    "linux",
    "open-source"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc --noEmit --skipLibCheck --incremental && electron-vite build",
    "build:fast": "electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "node scripts/dist-win.js",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb tar.gz",
    "preview": "electron-vite preview",
    "docs:dev": "vitepress dev docs-site --host",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --execArgv=--experimental-sqlite",
    "test:watch": "vitest --execArgv=--experimental-sqlite",
    "test:node": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "make-icon": "node scripts/make-icon.js",
    "compile-exe": "node scripts/compile-exe.js"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "node-pty": "^1.1.0",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.hihawarzid.omp-deck",
    "productName": "OmpDeck",
    "asar": true,
    "compression": "maximum",
    "afterPack": "./scripts/after-pack-cleanup.js",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/extensions",
        "to": "extensions",
        "filter": [
          "*.ts"
        ]
      },
      {
        "from": "resources/yao-prompts",
        "to": "yao-prompts"
      },
      {
        "from": "resources/xueprompts.db",
        "to": "xueprompts.db"
      },
      {
        "from": "build/pets",
        "to": "pets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "ayuayue <ayuayue@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "@astron-team/skillhub": "^0.1.8",
    "@electron-toolkit/preload": "^3.0.2",
    "@fiahfy/icns": "^0.0.7",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "eslint": "^10.6.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "png-to-ico": "^3.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-highlight-mark": "^1.4.0",
    "remark-math": "^6.0.0",
    "remove-markdown": "^0.6.4",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-language-server": "^5.3.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "zustand": "^5.0.0"
  }
}
